# Copy this file to .env and fill in your key. .env is ignored by git.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# TAG_MODEL=claude-haiku-4-5        # per-song tagging (cheap, fast)
# WRITER_MODEL=claude-sonnet-5-5    # era names + listening identity
# RESEARCH_MODEL=claude-haiku-4-5   # web-search tagging for songs without lyrics
# TAG_CONCURRENCY=8                 # parallel requests in live mode
# HOME_TZ=America/New_York          # time zone for US plays and unknown countries
